# =====================================================================
# Portal de Gestão — Grupo Setta · VARIÁVEIS DE AMBIENTE (modelo)
# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git
# (está no .gitignore) e é bloqueado ao navegador pelo .htaccess.
# Local recomendado do .env: UMA PASTA ACIMA da pasta pública (fora do public_html).
# Alternativa: na mesma pasta do api.php (protegido pelo .htaccess).
# Valores com caracteres especiais (@ ! # $ espaço): use aspas simples.
# =====================================================================

# --- Banco MySQL (painel da Localweb) ---
DB_HOST=pqualidade.mysql.dbaas.com.br
DB_PORT=3306
DB_NAME=pqualidade
DB_USER=pqualidade
DB_PASSWORD='coloque-a-senha-aqui'

# Prefixo das tabelas/visões (opcional)
DB_PREFIXO=setta_

# --- Instalação inicial ---
# Chave pedida UMA vez na tela "Instalação do servidor" (e no teste de conexão antes da instalação).
# Use um texto longo e aleatório (mínimo 12 caracteres).
SETTA_CHAVE_INSTALACAO='troque-por-uma-chave-longa-e-aleatoria'

# --- Interface publicada em outro endereço (ex.: GitHub Pages) ---
# Origens (protocolo + domínio, sem barra no final) autorizadas a usar esta API, separadas por vírgula.
# SETTA_CORS_ORIGENS=https://seu-usuario.github.io

# --- Opcionais ---
# SETTA_SESSAO_MINUTOS=480
# SETTA_MAX_ARQUIVO_MB=40
# SETTA_MAX_TENTATIVAS_LOGIN=5
# SETTA_EXIGIR_HTTPS=true          # ative depois que o certificado SSL estiver ativo
# SETTA_DIR_DADOS=/caminho/absoluto/fora/do/public_html/dados
# SETTA_DEBUG=false                # NUNCA true em produção
